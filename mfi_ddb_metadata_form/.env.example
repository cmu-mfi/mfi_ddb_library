# Copy to .env (next to compose.yaml) and adjust. All values are optional.

# MQTT broker the KV adapter publishes to
MQTT_BROKER_ADDRESS=host.docker.internal
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_ENTERPRISE=CMU
MQTT_SITE=Mill-19

# Identity recorded as the publisher (streamer.user) and used for "created_by"
FORM_USER_ID=metadata-form
FORM_USER_DOMAIN=ANDREW
FORM_USER_EMAIL=
FORM_USER_NAME=Metadata Form

# Metadata store (PostgreSQL) that 'user' field dropdowns are filled from
MDS_PG_HOST=host.docker.internal
MDS_PG_PORT=5430
MDS_PG_DATABASE=mds
MDS_PG_USER=mfi
MDS_PG_PASSWORD=mfiddb

# Retrieval API used by the Entries page; show all entries (true) or only the viewer's own (false)
RWS_URL=http://host.docker.internal:8000/mfi-ddb
ENTRIES_SHOW_ALL=true

# If set, the in-browser form builder asks for this token before saving
FORM_ADMIN_TOKEN=

# true = validate and log submissions without publishing
FORM_DRY_RUN=false
