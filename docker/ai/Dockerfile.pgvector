# Preserve the existing MDS PostgreSQL major version and Alpine base.
FROM postgres:15-alpine AS vector-build
ARG PGVECTOR_VERSION=0.8.7
RUN apk add --no-cache build-base curl \
    && curl -fsSL "https://github.com/pgvector/pgvector/archive/refs/tags/v${PGVECTOR_VERSION}.tar.gz" -o /tmp/vector.tar.gz \
    && echo "cac0b10c360f05b2d521200105ba3697e773d4cd3731f5a915a7e37ebe0bea85  /tmp/vector.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/vector.tar.gz -C /tmp \
    && make -C "/tmp/pgvector-${PGVECTOR_VERSION}" OPTFLAGS="" with_llvm=no \
    && make -C "/tmp/pgvector-${PGVECTOR_VERSION}" install with_llvm=no DESTDIR=/pgvector-install

FROM postgres:15-alpine
COPY --from=vector-build /pgvector-install/ /
