# Copy outside version control and supply your existing DDB user identity in a token file.
DDB_AI_TOKEN_FILE=/absolute/path/to/ddb-ai-tokens.json

# Compatible local model server, including the /v1 suffix.
DDB_AI_BASE_URL=http://host.docker.internal:11434/v1
DDB_AI_API_KEY=ollama
DDB_AI_EMBEDDING_MODEL=nomic-embed-text
DDB_AI_EMBEDDING_DIMENSIONS=768

# Optional: choose a model that supports function/tool calls.
# Install the chosen model on your model server before enabling chat.
DDB_AI_CHAT_MODEL=

# Sources may flush after terminal metadata arrives; reconcile late writes.
DDB_AI_SETTLE_SECONDS=30
DDB_AI_RECONCILE_SECONDS=900
DDB_AI_MAX_POINTS=100000
